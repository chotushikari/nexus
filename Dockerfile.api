FROM python:3.13-slim

WORKDIR /app

COPY apps/api/pyproject.toml apps/api/constraints.txt ./apps/api/
RUN pip install --no-cache-dir -c apps/api/constraints.txt "./apps/api[dev]"

COPY apps/api/nexus_api ./apps/api/nexus_api
COPY data ./data

ENV PORT=8080
ENV NEXUS_DATA_DIR=/app/data
ENV PYTHONPATH=/app/apps/api

CMD ["sh", "-c", "uvicorn nexus_api.application:app --host 0.0.0.0 --port ${PORT}"]

