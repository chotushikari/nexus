# ── Google Cloud ────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=nexus-enterprise-demo
GOOGLE_CLOUD_LOCATION=us-central1
FIRESTORE_DATABASE=nexus-db

# ── Enterprise identity (single source of truth for the demo narrative) ──────
ENTERPRISE_ID=meridian-industrial
ENTERPRISE_NAME=Meridian Industrial
DEFAULT_VENDOR_ID=kestrel-components
DEFAULT_VENDOR_NAME=Kestrel Components

# ── Gemini / ADK ────────────────────────────────────────────────────────────
# Model ids must be confirmed against the hackathon's approved model list.
# gemini-2.0-flash is a verified generally-available Flash-class model.
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MODEL_LITE=gemini-2.0-flash-lite
# Placeholder only. Never commit a real key.
GEMINI_API_KEY=replace-with-your-gemini-api-key
# Set true to authenticate through Vertex AI instead of an API key.
GOOGLE_GENAI_USE_VERTEXAI=false
# Capability switches: set false to force the honest fallback paths.
ENABLE_GEMINI_PLANNER=true
ENABLE_ADK=true
PLANNER_TIMEOUT_SECONDS=25
PLANNER_MAX_ATTEMPTS=2
ADK_TIMEOUT_SECONDS=20

# ── Backend ─────────────────────────────────────────────────────────────────
API_PORT=8000
API_BASE_URL=http://localhost:8000
NEXUS_API_KEY=replace-with-a-local-random-token
CORS_ORIGINS=http://localhost:3000

# ── Persistence ─────────────────────────────────────────────────────────────
# auto | memory | file | firestore
# auto  = try Firestore, fall back to the local JSON store (logged at startup).
# file  = local JSON store only (survives an API restart, no credentials needed).
STORE_BACKEND=auto
NEXUS_STATE_DIR=.nexus-state

# ── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/events
NEXT_PUBLIC_DEMO_MODE=true
# NEXT_PUBLIC_ENTERPRISE_ID is deprecated: the frontend should read enterprise
# identity, departments, and badge counts from GET /api/enterprise instead of
# baking a company id into the bundle.

# ── Demo ────────────────────────────────────────────────────────────────────
DEMO_MODE=true

# ── Safety / circuit breakers ───────────────────────────────────────────────
AGENT_MAX_ITERATIONS=10
AGENT_MAX_TOOL_CALLS=5
AGENT_MAX_ATTEMPTS=3
MISSION_MAX_RUNTIME_MINUTES=15
MISSION_MAX_TOOL_CALLS=50
MISSION_MAX_TASKS=20

# ── Logging / tracing ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
