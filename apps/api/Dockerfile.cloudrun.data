FROM python:3.13-slim

WORKDIR /app

COPY pyproject.toml constraints.txt ./
RUN pip install --no-cache-dir -c constraints.txt ".[dev]"

COPY nexus_api ./nexus_api
COPY data ./data

ENV PORT=8080
ENV NEXUS_DATA_DIR=/app/data

CMD ["sh", "-c", "uvicorn nexus_api.application:app --host 0.0.0.0 --port ${PORT}"]

